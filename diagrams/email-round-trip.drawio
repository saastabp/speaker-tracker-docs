<mxfile host="app.diagrams.net">
  <diagram id="email-round-trip" name="Email Round-Trip">
    <mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2400" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;Speaker Tracker — Email Round-Trip (production)&lt;/b&gt;&lt;br&gt;Outbound over SES · inbound over IMAP polling · one mailbox, one poller&lt;br&gt;Numbers give the order of one send, its reply, and the reply's import." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="76" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;── solid: request / data path&lt;br&gt;-- dashed: scheduled or credential read" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=6;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1">
          <mxGeometry x="40" y="112" width="320" height="64" as="geometry" />
        </mxCell>

        <mxCell id="lane-out" value="Outbound" style="whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 8;strokeColor=#5A6C86;fontColor=#5A6C86;verticalAlign=top;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="1620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lane-in" value="Inbound" style="whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 8;strokeColor=#5A6C86;fontColor=#5A6C86;verticalAlign=top;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="640" width="1620" height="400" as="geometry" />
        </mxCell>

        <mxCell id="lapi" value="Lambda — api&lt;br&gt;POST /emails/send · replies" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ses" value="SES (us-east-1)&lt;br&gt;DKIM-signed, MIME with&lt;br&gt;inline logo + attachments" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1">
          <mxGeometry x="860" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="contact" value="Venue contact&lt;br&gt;external recipient" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="1660" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="rds" value="RDS MySQL&lt;br&gt;email_threads · email_messages&lt;br&gt;message_id + external_message_id" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1">
          <mxGeometry x="400" y="740" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="lpoll" value="Lambda — imap-poll&lt;br&gt;reserved concurrency 1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="860" y="740" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="workmail" value="WorkMail mailbox (mail account)&lt;br&gt;INBOX · Sent&lt;br&gt;Speaker Tracker/Import → /Processed" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.workmail;" vertex="1" parent="1">
          <mxGeometry x="1320" y="740" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="mailclient" value="The user's mail client&lt;br&gt;a peer IMAP client" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.client;" vertex="1" parent="1">
          <mxGeometry x="1700" y="740" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ebrule" value="EventBridge Rule&lt;br&gt;rate(1 minute)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="620" y="1120" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="Secrets Manager&lt;br&gt;IMAP secret" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1120" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="S3 — content bucket&lt;br&gt;email/ · raw MIME" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="400" y="1120" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="note-mid" value="&lt;b&gt;SES rewrites the Message-ID.&lt;/b&gt;&lt;br&gt;The header the recipient sees is not the one&lt;br&gt;we mint, so the id returned by SendRawEmail&lt;br&gt;is stored as external_message_id — and&lt;br&gt;inbound In-Reply-To / References are matched&lt;br&gt;against either id. Without it, replies chain&lt;br&gt;against an id that never left the building." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;fillColor=#FFFFFF;strokeColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="1980" y="215" width="390" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note-in" value="&lt;b&gt;What makes ingest safe to repeat.&lt;/b&gt;&lt;br&gt;Per-folder UID cursors (reset on a UIDVALIDITY change) and&lt;br&gt;UNIQUE(user_id, message_id) — not the folder move. Raw MIME&lt;br&gt;is written before the row; only Import is moved, and only after&lt;br&gt;its row commits. Mail that continues no thread, is from no&lt;br&gt;tracked contact and was not imported is ignored, never stored.&lt;br&gt;Exactly one environment polls the mailbox." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=8;fillColor=#FFFFFF;strokeColor=#8C4FFF;" vertex="1" parent="1">
          <mxGeometry x="1980" y="700" width="390" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="① pending row&lt;br&gt;③ confirm + external_message_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;align=right;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lapi" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="② SendRawEmail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lapi" target="ses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="delivered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ses" target="contact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="④ APPEND to Sent (best-effort)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lapi" target="workmail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="439" y="240" /><mxPoint x="1340" y="240" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="⑤ reply → INBOX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="contact" target="workmail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1699" y="600" /><mxPoint x="1359" y="600" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="⑥ UID fetch above each cursor&lt;br&gt;INBOX · Sent · Import" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="workmail" target="lpoll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="⑦ raw MIME" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lpoll" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="800" y="806" /><mxPoint x="800" y="1000" /><mxPoint x="439" y="1000" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="⑧ thread by header chain (either id),&lt;br&gt;else sender + subject + time window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lpoll" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="⑨ Import only: move to Processed&lt;br&gt;after the row commits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=top;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="lpoll" target="workmail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="drag a message&lt;br&gt;into Import" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mailclient" target="workmail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ebrule" target="lpoll">
          <mxGeometry x="-0.6" relative="1" as="geometry">
            <Array as="points"><mxPoint x="659" y="1080" /><mxPoint x="880" y="1080" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="secrets" target="lpoll">
          <mxGeometry x="-0.6" relative="1" as="geometry">
            <Array as="points"><mxPoint x="1139" y="1080" /><mxPoint x="919" y="1080" /></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
