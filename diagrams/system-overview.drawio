        <mxCell id="note-db" value="Lambdas are &lt;b&gt;not&lt;/b&gt; VPC-attached.&lt;br&gt;The database is reached over its&lt;br&gt;public endpoint with IAM auth&lt;br&gt;(rds-db:connect) and TLS.&lt;br&gt;No NAT gateway anywhere in this app.&lt;br&gt;The RDS instance is shared with another&lt;br&gt;application, which owns its network&lt;br&gt;and parameter group." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=6;fillColor=#FFFFFF;strokeColor=#C925D1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="620" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note-poll" value="Exactly one environment may poll this&lt;br&gt;mailbox: two pollers would race over&lt;br&gt;the Import folder. Sandbox polling is off." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=6;fillColor=#FFFFFF;strokeColor=#DD344C;" vertex="1" parent="1">
